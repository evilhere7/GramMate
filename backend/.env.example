# GramMate Backend Configuration (.env file)
# Copy this file to .env and fill in your values

# ====== CORE SETTINGS ======
ENVIRONMENT=development
DEBUG=True
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ====== DATABASE ======
# For SQLite (development):
DATABASE_URL=sqlite:///./grammate.db

# For PostgreSQL (production) - uncomment and set:
# DATABASE_URL=postgresql://grammate:grammate_dev@localhost:5432/grammate

# ====== SECURITY ======
# Generate a strong SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====== EMAIL SERVICE (for verification, password reset, 2FA) ======
# Gmail: Use App Passwords (https://myaccount.google.com/apppasswords)
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-specific-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ====== PAYMENT INTEGRATION ======
STRIPE_API_KEY=sk_test_your_key_here

# ====== PLAID (Bank Integration) ======
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# ====== SOCIAL LOGIN (SSO) ======
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ====== RATE LIMITING ======
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=100

# ====== LOGGING ======
LOG_LEVEL=INFO

# ====== AWS (for S3 video storage) ======
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=grammate-videos
AWS_REGION=us-east-1

# ====== OPTIONAL: TWILIO (2FA SMS) ======
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ====== OPTIONAL: SENTRY (Error Tracking) ======
SENTRY_DSN=https://your-sentry-dsn@sentry.io/1234567

# ====== OPTIONAL: Redis (Session/Cache) ======
REDIS_URL=redis://localhost:6379/0

# ====== MONGODB CONFIGURATION ======
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=grammate_db
